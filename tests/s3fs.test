<?php

/**
 * S3 File System integration tests.
 *
 * These tests use Backdrop's native test base and require a configured S3
 * bucket and credentials. The hidden s3fs_test module provides an
 * hook_s3fs_upload_params_alter() implementation for the tests.
 */
class S3fsTests extends BackdropWebTestCase {

    /**
     * State variables.
     */
    protected $bucket_not_found = FALSE;
    protected $config = array();
    protected $s3;
    protected $remote_tests_folder = '_s3fs_tests';
    protected $remote_tests_folder_key = '_s3fs_tests';
    protected $remote_tests_folder_uri = 's3://_s3fs_tests';

    public static function getInfo() {
      return array(
        'name' => 'S3 File System Tests',
        'description' => 'Ensure that the remote file system functionality provided by S3 File System works correctly.',
        'group' => 'S3 File System',
      );
    }

    function setUp() {
      // Preserve the real site's S3 settings before SimpleTest switches to its
      // isolated database. Credentials managed by Key are copied as direct
      // test-only values into that isolated configuration.
      $source_config = config('s3fs.settings')->get();
      if (module_exists('key')) {
        $access_key_name = !empty($source_config['keymodule_access_key_name']) ? $source_config['keymodule_access_key_name'] : NULL;
        $secret_key_name = !empty($source_config['keymodule_secret_key_name']) ? $source_config['keymodule_secret_key_name'] : NULL;
        if ($access_key_name) {
          $source_config['s3fs_awssdk_access_key'] = key_get_key_value($access_key_name);
        }
        if ($secret_key_name) {
          $source_config['s3fs_awssdk_secret_key'] = key_get_key_value($secret_key_name);
        }
      }

      parent::setUp('s3fs', 'image', 's3fs_test');
      config('s3fs.settings')->setData($source_config)->save();
      backdrop_static_reset('config');
      // Empty out the bucket before the test, to prevent unexpected errors.
      $this->config = _s3fs_get_config(TRUE);
      $this->s3 = _s3fs_get_amazons3_client($this->config);
      if (!empty($this->config['root_folder'])) {
        $this->remote_tests_folder_key = "{$this->config['root_folder']}/$this->remote_tests_folder";
      }
      // Use the non-deprecated V2 existence check supported by AWS SDK v3.
      $this->bucket_not_found = !$this->s3->doesBucketExistV2($this->config['bucket']);
      if (!$this->bucket_not_found) {
        $this->s3->deleteMatchingObjects($this->config['bucket'], $this->remote_tests_folder_key);
        debug("Deleted file(s) from S3 test folder to prepare for the test.");
      }
    }

    /**
     * Coverage test for the stream wrapper.
     */
    public function testStreamWrapperCoverage() {
      // This is here, rather than the setUp() function, because we want the
      // test to immediately exit if this happens.
      if ($this->bucket_not_found) {
        $this->fail("The '{$this->config['bucket']}' bucket does not exist in the '{$this->config['region']}' region on your AWS account.
          Please configure S3 File System with an existing bucket in the configured region.");
        return;
      }
      $test_uri1 = "{$this->remote_tests_folder_uri}/test_file.txt";
      $test_uri2 = "{$this->remote_tests_folder_uri}/test_file2.txt";

      $this->assertTrue(file_stream_wrapper_valid_scheme('s3'), '"s3" is a valid stream wrapper scheme.');
      $this->assertEqual(file_stream_wrapper_get_class('s3'), 'S3fsStreamWrapper', 'URIs with scheme "s3" should be handled by S3fsStreamWrapper.');

      // The test.txt file is enough data to force multiple calls to write_stream().
      $file_contents = file_get_contents(backdrop_get_path('module', 's3fs') . '/tests/test.txt');

      $this->assertTrue(backdrop_mkdir($this->remote_tests_folder_uri), 'Exercised mkdir to create the testing directory (in the DB).');
      $this->assertTrue(is_dir($this->remote_tests_folder_uri), 'Make sure the folder we just created correctly reports that it is a folder.');

      debug("Exercising file upload functionality.");
      $start_time = time();
      $s3_file = file_save_data($file_contents, $test_uri1);
      $end_time = time();
      $total = $end_time - $start_time;
      debug("Upload time: $total seconds");

      $this->assertTrue($s3_file, "Uploaded the first test file, $test_uri1.");
      if (!$s3_file) {
        return;
      }
      $this->assertTrue(file_valid_uri($s3_file->uri), "Uploaded the first test file, $test_uri1.");

      debug("Exercising file copy functionality.");
      $s3_file2 = file_copy($s3_file, $test_uri2);
      $this->assertNotIdentical($s3_file2, FALSE, "Copied the the first test file to $test_uri2.");

      debug('Exercising the dir_*() functions.');
      $files = file_scan_directory($this->remote_tests_folder_uri, '#.*#');
      $this->assertTrue(isset($files[$test_uri1]), 'The first test file is in the tests directory.');
      $this->assertTrue(isset($files[$test_uri2]), 'The second test file is in the tests directory.');
      $this->assertEqual(count($files), 2, "There are exactly two files in the tests directory.");

      debug('Exercising getExternalUrl().');
      $url = file_create_url($test_uri1);
      $this->assertNotIdentical($url, FALSE, 'file_create_url() succeeded.');

      debug('Exercising unlink().');
      file_delete($s3_file->fid);
      $this->assertIdentical(file_exists($test_uri1), FALSE, 'The wrapper reports that the first test file no longer exists.');

      debug('Exercising rename().');
      $this->assertTrue(rename($test_uri2, $test_uri1), "Renamed the second test file to the newly-vacated URI of $test_uri1.");
      $s3_file2->uri = $test_uri1;
      file_save($s3_file2);

      debug('Exercising rmdir().');
      $this->assertFalse(backdrop_rmdir($this->remote_tests_folder_uri), 'rmdir() did not delete the tests folder because it is not empty.');
      file_delete($s3_file2->fid);
      $this->assertTrue(backdrop_rmdir($this->remote_tests_folder_uri), 'Deleted the tests folder.');
      $this->assertFalse(is_dir($this->remote_tests_folder_uri), 'The wrapper reports that the tests folder is gone.');
    }

    /**
     * Regression test for rename() deriving its ACL from the destination
     * scheme, not the source scheme (a private->public or public->private
     * rename must not inherit a stale ACL left in the shared stream
     * context by an earlier write).
     */
    public function testRenameCrossSchemeAcl() {
      if ($this->bucket_not_found) {
        $this->fail("The '{$this->config['bucket']}' bucket does not exist in the '{$this->config['region']}' region on your AWS account.
          Please configure S3 File System with an existing bucket in the configured region.");
        return;
      }

      if (!empty($this->config['disable_acl'])) {
        // Buckets using the "bucket owner enforced" Object Ownership setting
        // reject any request that includes an ACL, so this ACL-specific
        // regression test doesn't apply when the site has ACLs disabled.
        $this->pass('s3fs_disable_acl is enabled; skipping ACL-specific rename regression test.');
        return;
      }

      $public_folder = !empty($this->config['public_folder']) ? $this->config['public_folder'] : 's3fs-public';
      $private_folder = !empty($this->config['private_folder']) ? $this->config['private_folder'] : 's3fs-private';
      $root_prefix = !empty($this->config['root_folder']) ? $this->config['root_folder'] . '/' : '';

      $rel_path = $this->remote_tests_folder . '/acl_test.txt';
      $public_key = $root_prefix . $public_folder . '/' . $rel_path;
      $private_key = $root_prefix . $private_folder . '/' . $rel_path;
      $from_uri = "public://{$rel_path}";
      $to_uri = "private://{$rel_path}";

      // Seed the source object directly in S3.
      $this->s3->putObject(array(
        'Bucket' => $this->config['bucket'],
        'Key' => $public_key,
        'Body' => 'acl regression test',
        'ACL' => 'public-read',
      ));

      // Use the process-wide default context, and prime it with a stale ACL
      // the way stream_flush() leaves it after an earlier public write, to
      // reproduce the condition the original bug depended on.
      $default_context = stream_context_get_default();
      stream_context_set_option($default_context, 's3', 'ACL', 'public-read');

      $wrapper = new S3fsStreamWrapper();
      $wrapper->context = $default_context;

      try {
        // Cross-scheme rename: public -> private. Must end up private even
        // though the stale context ACL is 'public-read'.
        $this->assertTrue($wrapper->rename($from_uri, $to_uri), 'Renamed the public file to a private destination.');
        $acl = $this->s3->getObjectAcl(array('Bucket' => $this->config['bucket'], 'Key' => $private_key));
        $this->assertFalse($this->_acl_grants_public_read($acl), 'The public-to-private rename produced a private ACL, not public-read.');

        // Prime the context with a stale 'private' ACL before renaming back,
        // to prove the opposite direction isn't fooled by leftover state.
        stream_context_set_option($default_context, 's3', 'ACL', 'private');

        // Cross-scheme rename: private -> public. Must end up public-read
        // even though the stale context ACL is 'private'.
        $this->assertTrue($wrapper->rename($to_uri, $from_uri), 'Renamed the private file back to a public destination.');
        $acl = $this->s3->getObjectAcl(array('Bucket' => $this->config['bucket'], 'Key' => $public_key));
        $this->assertTrue($this->_acl_grants_public_read($acl), 'The private-to-public rename produced a public-read ACL.');
      }
      catch (\Exception $e) {
        $this->fail('Unexpected exception during cross-scheme rename ACL test: ' . $e->getMessage());
      }

      // Clean up. These objects live outside remote_tests_folder_key (which
      // only covers the s3:// scheme's key layout), so they need explicit
      // removal here rather than relying on tearDown().
      $this->s3->deleteMatchingObjects($this->config['bucket'], $public_key);
      $this->s3->deleteMatchingObjects($this->config['bucket'], $private_key);
    }

    /**
     * Regression test for per-file upload parameters persisting in the shared
     * default stream context. Parameters set for one upload (by s3fs or by
     * hook_s3fs_upload_params_alter()) must not apply to later uploads.
     */
    public function testUploadParamsDoNotPersist() {
      if ($this->bucket_not_found) {
        $this->fail("The '{$this->config['bucket']}' bucket does not exist in the '{$this->config['region']}' region on your AWS account.
          Please configure S3 File System with an existing bucket in the configured region.");
        return;
      }

      $root_prefix = !empty($this->config['root_folder']) ? $this->config['root_folder'] . '/' : '';
      $tagged_uri = "{$this->remote_tests_folder_uri}/hook_tagged.txt";
      $plain_uri = "{$this->remote_tests_folder_uri}/plain.txt";
      $plain_key = "{$this->remote_tests_folder_key}/plain.txt";

      // Snapshot the default context first: earlier tests in this process may
      // have left options in it deliberately, and they can't be removed.
      $default_before = stream_context_get_options(stream_context_get_default());

      // s3fs_test adds Cache-Control and Metadata to the tagged upload only.
      $this->assertTrue(file_put_contents($tagged_uri, 'tagged') !== FALSE, 'Uploaded the hook-tagged file.');
      $this->assertTrue(file_put_contents($plain_uri, 'plain') !== FALSE, 'Uploaded a plain file afterwards.');

      $default_after = stream_context_get_options(stream_context_get_default());
      unset($default_before['s3']['client'], $default_before['s3']['cache'], $default_after['s3']['client'], $default_after['s3']['cache']);
      $this->assertIdentical($default_after, $default_before, 'Uploads did not write any parameters to the default stream context.');

      $head = $this->s3->headObject(array('Bucket' => $this->config['bucket'], 'Key' => $plain_key));
      $this->assertTrue(empty($head['Metadata']['s3fs-test']), 'Hook-set Metadata did not carry over to the plain file.');
      if (empty($this->config['cache_control_header'])) {
        // With no configured header, s3fs never sets Cache-Control itself, so
        // any value here could only have leaked from the tagged upload.
        $this->assertTrue(empty($head['CacheControl']), 'Hook-set Cache-Control did not carry over to the plain file.');
      }

      // A public upload followed by a private one must not leave the private
      // object public-read.
      if (!empty($this->config['use_s3_for_private']) && empty($this->config['disable_acl'])) {
        $private_folder = !empty($this->config['private_folder']) ? $this->config['private_folder'] : 's3fs-private';
        $rel_path = $this->remote_tests_folder . '/acl_flush_test.txt';
        $private_key = $root_prefix . $private_folder . '/' . $rel_path;

        $this->assertTrue(file_put_contents("s3://{$this->remote_tests_folder}/public_first.txt", 'public') !== FALSE, 'Uploaded a public-read file first.');
        $this->assertTrue(file_put_contents("private://{$rel_path}", 'private') !== FALSE, 'Uploaded a private file afterwards.');
        $acl = $this->s3->getObjectAcl(array('Bucket' => $this->config['bucket'], 'Key' => $private_key));
        $this->assertFalse($this->_acl_grants_public_read($acl), 'The private upload did not inherit public-read from the earlier upload.');

        // This object lives outside remote_tests_folder_key, so tearDown()
        // won't remove it.
        $this->s3->deleteMatchingObjects($this->config['bucket'], $private_key);
      }
    }

    /**
     * Helper: does an S3 GetObjectAcl result grant read to the AllUsers
     * group (i.e. is the object effectively public-read)?
     */
    protected function _acl_grants_public_read($acl) {
      foreach ($acl['Grants'] as $grant) {
        if (!empty($grant['Grantee']['URI']) && strpos($grant['Grantee']['URI'], '/groups/global/AllUsers') !== FALSE) {
          return TRUE;
        }
      }
      return FALSE;
    }

    /**
     * Test the image derivative functionality.
     */
    public function testImageDerivatives() {
      // This is here, rather than the setUp() function, because we want the
      // test to immediately exit if this happens.
      if ($this->bucket_not_found) {
        $this->fail("The '{$this->config['bucket']}' bucket does not exist in the '{$this->config['region']}' region on your AWS account.
          Please configure S3 File System with an existing bucket in the configured region.");
        return;
      }
      $img_uri1 = "{$this->remote_tests_folder_uri}/test.png";
      $img_localpath = backdrop_get_path('module', 's3fs') . '/tests/test.png';

      // Upload the test image.
      $this->assertTrue(backdrop_mkdir($this->remote_tests_folder_uri), 'Created the testing directory in the DB.');
      $img_data = file_get_contents($img_localpath);
      $img_file = file_save_data($img_data, $img_uri1);
      $this->assertTrue($img_file, "Copied the the test image to $img_uri1.");
      if (!$img_file) {
        return;
      }

      // Request a derivative.
      // Parse query parameters to ensure they get passed.
      $style_url_parsed = backdrop_parse_url(image_style_url('thumbnail', $img_uri1));
      $derivative = $this->backdropGet($style_url_parsed['path'], array('query' => $style_url_parsed['query']));
      $this->assertTrue(imagecreatefromstring($derivative), 'The returned derivative is a valid image.');
    }

    /**
     * Test adding and removing an image from a node.
     */
    public function testNodeImageAddAndRemove() {
      if ($this->bucket_not_found) {
        $this->fail("The '{$this->config['bucket']}' bucket does not exist in the '{$this->config['region']}' region.");
        return;
      }

      $field_name = 'field_s3fs_test_image';
      field_create_field(array(
        'field_name' => $field_name,
        'type' => 'image',
        'cardinality' => 1,
      ));
      field_create_instance(array(
        'field_name' => $field_name,
        'entity_type' => 'node',
        'bundle' => 'page',
        'label' => 'S3fs test image',
        'required' => FALSE,
      ));

      $this->assertTrue(backdrop_mkdir($this->remote_tests_folder_uri), 'Created the node image test directory in S3.');
      $image_uri = "{$this->remote_tests_folder_uri}/node-image.png";
      $image = file_save_data(
        file_get_contents(backdrop_get_path('module', 's3fs') . '/tests/test.png'),
        $image_uri,
        FILE_EXISTS_REPLACE
      );
      $this->assertTrue($image, 'Uploaded the node image to S3.');
      if (!$image) {
        return;
      }
      $image->status = FILE_STATUS_PERMANENT;
      file_save($image);

      $node = $this->backdropCreateNode(array(
        'type' => 'page',
        'title' => 'S3fs image test',
      ));
      $node->{$field_name}[LANGUAGE_NONE][0] = array(
        'fid' => $image->fid,
        'alt' => 'S3fs test image',
      );
      node_save($node);

      $saved_node = node_load($node->nid, NULL, TRUE);
      $this->assertEqual(
        $saved_node->{$field_name}[LANGUAGE_NONE][0]['fid'],
        $image->fid,
        'The image is attached to the node.'
      );

      $saved_node->{$field_name}[LANGUAGE_NONE] = array();
      node_save($saved_node);
      $saved_node = node_load($node->nid, NULL, TRUE);
      $this->assertTrue(
        empty($saved_node->{$field_name}[LANGUAGE_NONE]),
        'The image can be removed from the node.'
      );

      file_delete($image->fid);
      node_delete($node->nid);
    }

    /**
     * Test the cache refresh.
     */
    public function testCacheRefresh() {
      // This is here, rather than the setUp() function, because we want the
      // test to immediately exit if this happens.
      if ($this->bucket_not_found) {
        $this->fail("The '{$this->config['bucket']}' bucket does not exist in the '{$this->config['region']}' region on your AWS account.
          Please configure S3 File System with an existing bucket in the configured region.");
        return;
      }

      // Add several files to the bucket using the AWS SDK directly, so that
      // s3fs won't cache them.
      $filenames = array('files/test2.txt', 'parts/test3.txt', 'test.txt', );
      foreach ($filenames as $filename) {
        $filename = $this->remote_tests_folder_key . '/' . $filename;
        $this->s3->putObject(
          array(
            'Bucket' => $this->config['bucket'],
            'Key' => $filename,
            'ACL' => 'public-read',
          )
        );
      }

      $config = _s3fs_get_config();
      // Set the current test folder as the root prefix.
      $config['root_folder'] = $this->remote_tests_folder_key;
      _s3fs_refresh_cache($config);

      // Query the DB to confirm that all the new files are cached.
      $result = db_select('s3fs_file', 's')
        ->fields('s')
        ->condition('dir', 0, '=')
        ->execute();
      $cached_files = array();
      foreach ($result as $record) {
        $cached_files[] = str_replace('s3://', '', $record->uri);
      }
      $this->assertEqual($filenames, $cached_files, 'The test files were all cached.');

      // Flush the cache, then do a refresh using the root_folder setting.
      // Only the file in the root folder (test3.txt) should become cached.
      $delete_query = db_delete('s3fs_file')->execute();
      $config['root_folder'] = $this->remote_tests_folder_key . '/parts';
      _s3fs_refresh_cache($config);

      // Confirm that only the file in the "parts" folder was cached.
      $records = db_select('s3fs_file', 's')
        ->fields('s')
        ->condition('dir', 0, '=')
        ->execute()
        ->fetchAll();
      $this->assertEqual(count($records), 1, 'There was only one file in the partially rereshed cache.');
      $this->assertEqual($records[0]->uri, 's3://test3.txt', 'That file was the one in the "parts" folder, which is now the root folder, so "parts" is not in the URI.');
    }

    /**
     * Clean up S3 folder.
     */
    public function tearDown() {
      if ($this->s3 && !empty($this->config['bucket'])) {
        $this->s3->deleteMatchingObjects($this->config['bucket'], $this->remote_tests_folder_key);
      }
      parent::tearDown();
    }
} // END S3fsTests class
